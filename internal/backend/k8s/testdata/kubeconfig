# Two contexts, sanitised for tests: hostnames are example.internal and the
# credentials are placeholders. Never put a real kubeconfig in testdata/.
apiVersion: v1
kind: Config
current-context: alpha
clusters:
  - name: alpha-cluster
    cluster:
      server: https://alpha.example.internal:6443
      insecure-skip-tls-verify: true
  - name: beta-cluster
    cluster:
      server: https://beta.example.internal:6443
      insecure-skip-tls-verify: true
users:
  - name: alpha-user
    user:
      token: REDACTED
  - name: beta-user
    user:
      token: REDACTED
contexts:
  - name: alpha
    context:
      cluster: alpha-cluster
      user: alpha-user
      namespace: alpha-ns
  - name: beta
    context:
      cluster: beta-cluster
      user: beta-user
