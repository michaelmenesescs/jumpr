{
  "status": "success",
  "data": {
    "groups": [
      {
        "name": "node-rules",
        "file": "/etc/prometheus/rules/node.yml",
        "rules": [
          {
            "name": "NodeDown",
            "query": "up{job=\"node\"} == 0",
            "duration": 300,
            "health": "ok",
            "type": "alerting",
            "alerts": [
              {
                "labels": {
                  "alertname": "NodeDown",
                  "instance": "db-01.example.internal:9100"
                },
                "annotations": {
                  "summary": "node down"
                },
                "state": "firing",
                "activeAt": "2026-11-12T13:40:00Z",
                "value": "0e+00"
              }
            ]
          },
          {
            "name": "job:up:avg",
            "query": "avg by (job) (up)",
            "duration": 0,
            "health": "ok",
            "type": "recording"
          }
        ]
      }
    ]
  }
}
